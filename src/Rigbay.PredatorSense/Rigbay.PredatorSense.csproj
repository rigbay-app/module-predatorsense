<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone module repository. The host contract is the git submodule external/rigbay (pinned to a commit of
    https://github.com/rigbay-app/rigbay); nothing is published as a package. Clone with the recurse-submodules option.
    Rigbay.Abstractions.dll must NOT end up in the output folder: the host supplies its own copy.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Rigbay.PredatorSense</RootNamespace>
    <AssemblyName>Rigbay.PredatorSense</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute"><_Parameter1>windows</_Parameter1></AssemblyAttribute>
    <InternalsVisibleTo Include="Rigbay.PredatorSense.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\rigbay\src\Rigbay.Abstractions\Rigbay.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- Not part of the host (the host's default context does not have it); the loader rule finds it in this folder. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <None Include="..\..\module.json" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
    <!-- the module's icon (manifest field "icon"): tile, quiet glyph, grey variant and the PNG fallbacks sit next to module.json -->
    <None Include="..\..\icon*.svg;..\..\icon*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
    <None Include="lang\*.lang" CopyToOutputDirectory="PreserveNewest" LinkBase="lang" />
  </ItemGroup>

</Project>
